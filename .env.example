# Multi-Agent AI Finance Assistant - Environment Variables
# Copy this file to .env and fill in your API keys

# ============================================
# REQUIRED: Google Gemini API Configuration
# ============================================
# Get your free API key from: https://ai.google.dev/
# Sign up with your Google account and create a new API key
GEMINI_API_KEY="your-gemini-api-key-here"

# ============================================
# OPTIONAL: API Configuration
# ============================================
# For production deployments with separated frontend/backend
# Default: http://localhost:8000
# API_URL="http://localhost:8000"

# For Streamlit Cloud deployment, set this in Streamlit secrets
# API_URL="https://your-backend-service.render.com"

# ============================================
# API Rate Limits (Google Gemini Free Tier)
# ============================================
# gemini-2.0-flash-exp: 10 requests/min, 1500 requests/day
# gemini-2.5-pro: 50 requests/day
# 
# For higher limits, upgrade at: https://ai.google.dev/pricing
#
# Tips to avoid rate limits:
# 1. Use gemini-2.0-flash-exp for frequent queries
# 2. Create multiple Google Cloud projects
# 3. Implement request caching (planned feature)
# 4. Upgrade to paid tier for production

# ============================================
# OPTIONAL: Deployment Configuration
# ============================================
# PORT=8000
# HOST=0.0.0.0
# DEBUG=False

# ============================================
# OPTIONAL: Logging Configuration
# ============================================
# LOG_LEVEL=INFO
# LOG_FILE=app.log

# ============================================================
# OPTIONAL: NSE India MCP market data (see docs/nse_mcp_integration.md)
# ============================================================
# NSE_MCP_ENABLED=true
# NSE_MCP_TIMEOUT_SECONDS=10
# NSE_MCP_ATTEMPTS=3
# NSE_MCP_COOLDOWN_SECONDS=45

# ============================================================
# OPTIONAL: Gemini model and reliability (see agents/gemini_client.py)
# ============================================================
# Defaults shown. The SDK in requirements.txt is google-generativeai (deprecated upstream in favour of google-genai).
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_MAX_RETRIES=2                 # retries after the first attempt, for HTTP 429 / transient errors only; integer 0-5
# GEMINI_RETRY_BASE_SECONDS=1.0        # first backoff delay; doubles each retry; 0-60 (lowered to the max below if larger)
# GEMINI_RETRY_MAX_SECONDS=15          # longest single wait; a longer server-provided retry delay is not waited for; 0-120
# GEMINI_REQUEST_TIMEOUT_SECONDS=20    # per request (SDK default is 600); > 0 and <= 120
# GEMINI_TOTAL_BUDGET_SECONDS=45       # hard wall-clock budget for one call including retries; > 0 and <= 600
# Numbers must be finite (inf / nan are rejected). Values above a maximum are clamped; any other invalid value is
# ignored (default used) with a warning in the log.
# When Gemini is unavailable the deterministic rule-based analysis is used and each report says so
# in its "generation" field ({"source": "fallback", "reason": ...}).
